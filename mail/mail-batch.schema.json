{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "life-os.mail-batch.v1",
  "title": "Life OS mail batch, version 1",
  "description": "What one gathering run found in Xar's mailboxes: the sources it read, a digest, the messages, and what she owes people. Written by an agent into mail/inbox/, imported by Life OS. Priorities and actions are suggestions; her own changes in Life OS always win.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "runId", "gatheredAt", "agent", "sources", "digest", "messages", "actions"],
  "properties": {
    "format": { "const": "life-os.mail-batch" },
    "version": { "const": 1 },
    "runId": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}-\\d{4}-[a-z0-9]{6}$" },
    "gatheredAt": { "type": "string", "format": "date-time" },
    "agent": { "type": "string", "minLength": 1, "maxLength": 200 },
    "sources": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "$ref": "#/$defs/source" } },
    "digest": { "$ref": "#/$defs/digest" },
    "messages": { "type": "array", "maxItems": 2000, "items": { "$ref": "#/$defs/message" } },
    "actions": { "type": "array", "maxItems": 300, "items": { "$ref": "#/$defs/action" } }
  },
  "$defs": {
    "sourceId": { "type": "string", "pattern": "^[a-z0-9-]{1,40}$" },
    "priority": { "enum": ["urgent", "high", "normal", "low"] },
    "person": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "maxLength": 200 },
        "address": { "type": "string", "maxLength": 320 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "kind", "route", "status", "coverage"],
      "properties": {
        "id": { "$ref": "#/$defs/sourceId" },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "kind": { "enum": ["gmail", "outlook", "learning-central", "teams", "other"] },
        "address": { "type": "string", "maxLength": 320 },
        "route": { "enum": ["connector", "browser", "export", "none"] },
        "status": { "enum": ["read", "partial", "unavailable"] },
        "window": {
          "type": "object",
          "additionalProperties": false,
          "required": ["from", "to"],
          "properties": {
            "from": { "type": "string", "format": "date-time" },
            "to": { "type": "string", "format": "date-time" }
          }
        },
        "coverage": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["headline"],
      "properties": {
        "headline": { "type": "string", "minLength": 1, "maxLength": 300 },
        "bySource": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "summary"],
            "properties": {
              "source": { "$ref": "#/$defs/sourceId" },
              "summary": { "type": "string", "minLength": 1, "maxLength": 1000 }
            }
          }
        },
        "needsYou": { "type": "array", "maxItems": 10, "items": { "type": "string", "minLength": 1, "maxLength": 300 } },
        "deadlines": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "date"],
            "properties": {
              "title": { "type": "string", "minLength": 1, "maxLength": 200 },
              "date": { "type": "string", "format": "date" },
              "ref": { "type": "string", "pattern": "^[am][0-9]{1,5}$" }
            }
          }
        },
        "gaps": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 300 } }
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "source", "sourceId", "kind", "receivedAt", "from", "subject", "summary", "category", "priority"],
      "properties": {
        "ref": { "type": "string", "pattern": "^m[0-9]{1,5}$" },
        "source": { "$ref": "#/$defs/sourceId" },
        "sourceId": { "type": "string", "minLength": 1, "maxLength": 300 },
        "threadId": { "type": "string", "maxLength": 300 },
        "kind": { "enum": ["email", "announcement", "chat", "notification"] },
        "receivedAt": { "type": "string", "format": "date-time" },
        "from": { "$ref": "#/$defs/person" },
        "to": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/person" } },
        "cc": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/person" } },
        "subject": { "type": "string", "maxLength": 500 },
        "course": { "type": "string", "maxLength": 200 },
        "folder": { "type": "string", "maxLength": 100 },
        "unreadAtSource": { "type": "boolean" },
        "repliedAtSource": { "type": "boolean" },
        "attachments": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 300 },
              "size": { "type": "integer" }
            }
          }
        },
        "link": { "type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2000 },
        "text": { "type": "string", "maxLength": 20000 },
        "textComplete": { "type": "boolean" },
        "summary": { "type": "string", "minLength": 1, "maxLength": 600 },
        "category": { "enum": ["needs-you", "deadline", "announcement", "conversation", "fyi", "newsletter", "automated", "noise"] },
        "priority": { "$ref": "#/$defs/priority" },
        "priorityReason": { "type": "string", "maxLength": 300 },
        "deadline": { "type": "string", "format": "date" }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "kind", "title", "priority", "dedupeKey"],
      "properties": {
        "ref": { "type": "string", "pattern": "^a[0-9]{1,5}$" },
        "kind": { "enum": ["reply", "email", "text", "call", "read", "do", "decide"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "why": { "type": "string", "maxLength": 500 },
        "person": { "$ref": "#/$defs/person" },
        "since": { "type": "string", "format": "date-time" },
        "due": { "type": "string", "format": "date" },
        "priority": { "$ref": "#/$defs/priority" },
        "messageRefs": { "type": "array", "maxItems": 20, "items": { "type": "string", "pattern": "^m[0-9]{1,5}$" } },
        "dedupeKey": { "type": "string", "minLength": 3, "maxLength": 400 },
        "resolvedAtSource": { "type": "boolean" },
        "resolvedNote": { "type": "string", "maxLength": 300 }
      }
    }
  }
}
