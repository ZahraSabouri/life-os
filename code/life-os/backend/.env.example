# Life OS settings. Copy this file to .env beside it and change what you need; every line is optional.
# The server reads it when it starts (hosting/server.mjs). Never commit .env itself.

# Where Life OS answers. Keep it on 127.0.0.1 unless you have put it behind something that protects it.
LIFE_OS_PORT=47850
LIFE_OS_ORIGIN=http://127.0.0.1:47850

# The key the pages and your own scripts send. Change it, and set the same value for the page build
# (VITE_LIFE_OS_TOKEN in code/life-os/frontend/.env) before building.
LIFE_OS_TOKEN=change-me-to-a-long-random-key

# Where your data and backups live: outside the app folder, so the code never holds them.
# Default: the folders Life_OS_data and Life_OS_backups beside the app folder.
LIFE_OS_DATA_DIR=../Life_OS_data
LIFE_OS_BACKUP_DIR=../Life_OS_backups

# The Events research folder (events.csv, its notes, events-settings.json with your city, and the
# page built from them by events/build_html.py). Default: events in the data folder.
# A relative path is read from the app folder.
LIFE_OS_EVENTS_DIR=../Life_OS_data/events

# Addresses that moved, so old links and bookmarks still open: "old=new" pairs, comma-separated.
# A pair ending in / moves everything under it. Example: /my-old-page=/events,/apps/my-old-page/=/apps/events/
LIFE_OS_MOVED_ADDRESSES=

# The PostgreSQL settings file (see postgres.example.json). Default: .runtime/postgres.json in the app folder.
LIFE_OS_DATABASE_CONFIG=.runtime/postgres.json

# Only for the older stand-alone API server (npm start in code/life-os/backend), not the whole app.
PORT=3001

# The ports of the two attached apps, which Life OS starts and shows inside itself.
LIFE_OS_BUDGET_PORT=47851
LIFE_OS_JOBMAP_PORT=47852
